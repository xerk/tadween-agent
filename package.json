{
  "name": "tadween",
  "version": "1.0.0",
  "description": "Tadween CLI - Command line interface for the Tadween social media scheduling API",
  "main": "dist/index.js",
  "bin": {
    "tadween": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsup --watch",
    "sync-skill": "cp SKILL.md skills/tadween/SKILL.md",
    "build": "tsup",
    "start": "node ./dist/index.js",
    "prepublishOnly": "pnpm run build",
    "release": "tsup && pnpm publish --access public --no-git-checks"
  },
  "files": [
    "dist",
    "README.md",
    "SKILL.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "tadween",
    "cli",
    "social-media",
    "scheduling",
    "automation",
    "ai-agent",
    "command-line",
    "twitter",
    "linkedin",
    "facebook",
    "instagram",
    "tiktok",
    "youtube",
    "reddit"
  ],
  "author": "Xerk LLC",
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xerk/tadween-agent.git"
  },
  "homepage": "https://tadween.app",
  "bugs": {
    "url": "https://github.com/xerk/tadween-agent/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@types/pg": "^8.20.0",
    "node-fetch": "^3.3.2",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@types/node": "^20.11.19",
    "@types/yargs": "^17.0.32",
    "tsup": "^8.5.1",
    "typescript": "^5.3.3"
  },
  "contributors": [
    "Nevo David (original Postiz CLI, https://github.com/gitroomhq/postiz-agent)"
  ]
}
