{
  "name": "dsh-tadween",
  "version": "1.0.0",
  "description": "DeepSeek Harness plugin that connects the agent to Tadween over MCP: list connected channels, fetch platform posting rules, and schedule, draft, or publish social media posts across 28+ platforms.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "tadween",
    "mcp",
    "social-media",
    "social-media-scheduler",
    "scheduling",
    "automation"
  ],
  "author": {
    "name": "Xerk LLC",
    "url": "https://tadween.app"
  },
  "homepage": "https://github.com/xerk/tadween-agent/tree/tadween/plugins/dsh-tadween#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xerk/tadween-agent.git",
    "directory": "plugins/dsh-tadween"
  },
  "bugs": {
    "url": "https://github.com/xerk/tadween-agent/issues"
  },
  "license": "AGPL-3.0",
  "publishConfig": {
    "access": "public"
  },
  "contributors": [
    "Nevo David (original dsh-postiz, https://github.com/gitroomhq/postiz-agent)"
  ]
}
